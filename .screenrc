shell zsh
startup_message off
history 100000
autodetach on
defutf8 on # utf8
# scrollback lines
defscrollback 100000
nonblock on

vbell on
vbell_msg ""

hardstatus on
hardstatus alwayslastline
hardstatus string "%{.bW}%-w%{.rW}%n %t%{-}%+w %=%{..G} %H %{..Y} %D %y/%m/%d %c "

# copy and paste
# copy mode: C-a C-[ oder C-a <ESC>
# markieren funktioniert über Marken setzen mit <space>  w=word,y=lineend,Y=line
# paste: C-a C-]  or here C-a P
bind P paste .

# toggle focus in split screen mode like C-a <TAB>
bind o focus
# jump to other focus in split screen mode
bind j focus down
bind k focus up
bind t focus top
bind b focus bottom

# testen
altscreen on
defflow off

####################
### Key Bindings ###
####################
# add a binding to get an irb session
#bind i screen irb

#######################
### Default Windows ###
#######################
screen -t root 0 zsh
chdir $GOPATH/src/github.com/zalando-incubator/kubernetes-on-aws
screen -t kube 1 zsh
screen -t kube 2 zsh
chdir $GOPATH/src/github.com/zalando/skipper
screen -t skipper 3 zsh
screen -t skipper 4 zsh
chdir $HOME/src/oss/xdp-tutorial/basic01-xdp-pass
screen -t xdp 5 zsh
chdir $GOPATH/src/github.com/zalando-build/pod-deletion-cost-controller
screen -t pod-del-cost 6 zsh
screen -t pod-del-cost 7 zsh
chdir $HOME
select 0

